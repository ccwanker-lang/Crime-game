properties/1/path = NodePath(".:health")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:dead")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:wanted_stars")
properties/3/spawn = true
properties/3/replication_mode = 2
properties/4/path = NodePath(".:wanted_seen")
properties/4/spawn = true
properties/4/replication_mode = 2

[node name="Player" type="CharacterBody3D"]
collision_layer = 8
collision_mask = 11
floor_snap_length = 0.4
script = ExtResource("1_player")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Capsule")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.62, 0)

[node name="Spring" type="SpringArm3D" parent="Head"]
collision_mask = 3
shape = SubResource("CamProbe")
spring_length = 0.0
margin = 0.05

[node name="Camera3D" type="Camera3D" parent="Head/Spring"]
fov = 75.0
near = 0.05

[node name="Nametag" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.1, 0)
pixel_size = 0.004
billboard = 1
double_sided = false
fixed_size = false
modulate = Color(1, 1, 1, 0.95)
outline_modulate = Color(0, 0, 0, 0.85)
font_size = 48
outline_size = 10
text = "Player"

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
public_visibility = false
replication_interval = 0.033
replication_config = SubResource("Replication")

[node name="HostSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
public_visibility = false
replication_config = SubResource("HostReplication")

[node name="Combat" type="Node" parent="."]
script = ExtResource("2_combat")

[node name="UI" type="CanvasLayer" parent="."]
