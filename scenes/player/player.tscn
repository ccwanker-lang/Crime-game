[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/player/player.gd" id="1_player"]
[ext_resource type="Script" path="res://scenes/player/player_combat.gd" id="2_combat"]
[ext_resource type="Script" path="res://scenes/player/hud.gd" id="3_hud"]

[sub_resource type="CapsuleShape3D" id="Capsule"]
resource_local_to_scene = true
radius = 0.35
height = 1.8

[sub_resource type="SphereShape3D" id="CamProbe"]
radius = 0.2

[sub_resource type="SceneReplicationConfig" id="Replication"]
properties/0/path = NodePath(".:net_pos")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:net_yaw")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:net_pitch")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:net_move")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath(".:net_sprint")
properties/4/spawn = true
properties/4/replication_mode = 2
properties/5/path = NodePath(".:net_crouch")
properties/5/spawn = true
properties/5/replication_mode = 2
